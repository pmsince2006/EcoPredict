# ==========================================
# EcoPredict — Environment Variables Template
# Copy this file to .env and fill in real values for local development.
# DO NOT commit real secrets, API keys, or credentials to version control.
# ==========================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_ENABLE_MOCK_DATA=true

# External Air Quality & Weather API Placeholders
# (Specify provider keys if utilizing external telemetry, e.g. OpenAQ, CPCB, or OpenWeather)
OPENAQ_API_KEY=your_openaq_api_key_placeholder
OPENWEATHER_API_KEY=your_openweather_api_key_placeholder

# Machine Learning Service / Model Paths
MODEL_ARTIFACTS_DIR=ml/models
DEFAULT_MODEL_NAME=aqi_random_forest_v1.pkl
